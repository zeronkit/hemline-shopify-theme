        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Shipping and returns",
            "source": "shipping"
          }
        },
        "fit_tab": {
          "type": "collapsible",
          "settings": {
            "heading": "Fit",
            "source": "fit"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "picker",
        "fit",
        "buy",
        "description",
        "complementary",
        "care",
        "fit_tab",
        "shipping"
