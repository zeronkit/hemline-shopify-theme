{%- comment -%}
  A top level header link. Links with children open their navigator panel.
  Params: link, panel_id
{%- endcomment -%}
{%- if link.links.size > 0 -%}
  <button type="button" class="hm-header__link" data-hm-open="Navigator" data-hm-panel="{{ panel_id }}" aria-haspopup="dialog">
    {{- link.title | escape -}}
    {% render 'icon', name: 'down' %}
  </button>
{%- else -%}
  <a class="hm-header__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
{%- endif -%}
