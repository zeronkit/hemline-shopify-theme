{%- comment -%}
  Params: id (unique), predictive (boolean), value (optional current terms)
{%- endcomment -%}
<form action="{{ routes.search_url }}" method="get" role="search" class="hm-search-form">
  <label class="hm-visually-hidden" for="{{ id }}">{{ 'search.label' | t }}</label>
  {%- if predictive -%}<hm-predictive-search class="hm-predictive" data-url="{{ routes.predictive_search_url }}">{%- endif -%}
  <div class="hm-search-form__field">
    <input
      class="hm-input hm-search-form__input"
      type="search"
      id="{{ id }}"
      name="q"
      value="{{ value | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      autocomplete="off"
      {% if predictive %}
        role="combobox"
        aria-expanded="false"
        aria-controls="{{ id }}-results"
        aria-autocomplete="list"
      {% endif %}
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="hm-icon-button" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
  </div>
  {%- if predictive -%}
      <div class="hm-predictive__results" id="{{ id }}-results" data-hm-results hidden></div>
    </hm-predictive-search>
  {%- endif -%}
</form>
