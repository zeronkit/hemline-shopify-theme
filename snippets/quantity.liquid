{%- comment -%}
  Params: id, name, value, min, line (cart line index, optional), label (optional accessible label)
{%- endcomment -%}
<hm-quantity class="hm-qty">
  <button type="button" class="hm-qty__btn" data-step="-1" aria-label="{{ 'products.quantity_down' | t }}">{% render 'icon', name: 'minus' %}</button>
  <input
    class="hm-qty__input"
    type="number"
    inputmode="numeric"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value }}"
    min="{{ min | default: 0 }}"
    {% if line %}data-line="{{ line }}"{% endif %}
    {% if label %}aria-label="{{ label | escape }}"{% endif %}
  >
  <button type="button" class="hm-qty__btn" data-step="1" aria-label="{{ 'products.quantity_up' | t }}">{% render 'icon', name: 'plus' %}</button>
</hm-quantity>
