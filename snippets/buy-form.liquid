{%- comment -%}
  Product form: selling plans, quantity, add to cart, accelerated checkout,
  Shop Pay Installments banner and pickup availability.
  Params: product, variant, section_id, show_checkout, show_pickup, show_quantity
{%- endcomment -%}
{%- assign form_id = 'ProductForm-' | append: section_id -%}
<hm-product-form>
  {%- form 'product', product, id: form_id, class: 'hm-buy', novalidate: 'novalidate' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>

    {%- if product.selling_plan_groups.size > 0 and variant.selling_plan_allocations.size > 0 -%}
      <fieldset class="hm-plans">
        <legend class="hm-field__label">{{ 'products.purchase_options' | t }}</legend>
        {%- unless product.requires_selling_plan -%}
          <label class="hm-plans__row">
            <input type="radio" name="selling_plan" value="" checked>
            <span>{{ 'products.one_time' | t }}</span>
            <span class="hm-plans__price">{{ variant.price | money }}</span>
          </label>
        {%- endunless -%}
        {%- for allocation in variant.selling_plan_allocations -%}
          <label class="hm-plans__row">
            <input type="radio" name="selling_plan" value="{{ allocation.selling_plan.id }}" {% if product.requires_selling_plan and forloop.first %}checked{% endif %}>
            <span>{{ allocation.selling_plan.name | escape }}</span>
            <span class="hm-plans__price">{{ allocation.price | money }}</span>
          </label>
        {%- endfor -%}
      </fieldset>
    {%- endif -%}

    <div class="hm-buy__row">
      {%- if show_quantity -%}
        {%- assign qty_id = 'Quantity-' | append: section_id -%}
        <div class="hm-field hm-buy__qty">
          <label class="hm-visually-hidden" for="{{ qty_id }}">{{ 'products.quantity' | t }}</label>
          {% render 'quantity', id: qty_id, name: 'quantity', value: 1, min: 1 %}
        </div>
      {%- endif -%}
      <button type="submit" name="add" class="hm-button hm-button--primary hm-buy__add" {% unless variant.available %}disabled{% endunless %}>
        {%- if variant.available -%}
          {{ 'products.add_to_cart' | t }}
        {%- elsif variant == blank -%}
          {{ 'products.unavailable' | t }}
        {%- else -%}
          {{ 'products.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>

    {%- if show_checkout -%}
      <div class="hm-buy__checkout">{{ form | payment_button }}</div>
    {%- endif -%}

    <div class="hm-buy__terms">{{ form | payment_terms }}</div>
    <p class="hm-buy__error" role="alert" hidden data-hm-error></p>
  {%- endform -%}
</hm-product-form>

{%- if show_pickup and variant.available -%}
  <hm-pickup class="hm-pickup" data-url="{{ routes.root_url | append: '/variants/' | replace: '//', '/' }}{{ variant.id }}/?section_id=pickup-availability"></hm-pickup>
{%- endif -%}
