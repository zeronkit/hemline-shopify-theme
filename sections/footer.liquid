{%- comment -%} Hemline theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- comment -%}
  Footer with three layouts. Menu blocks fall back to the "footer" menu, then to the store's
  common pages and blog, so the footer is never empty. Policies are always listed automatically.
{%- endcomment -%}
{%- liquid
  assign auto_pages = 'about-us,contact,faq,size-guide,shipping-and-returns,returns,shipping' | split: ','
-%}
<footer class="hm-footer hm-footer--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}">
  <div class="hm-wrap">
    <div class="hm-footer__top">
      {%- if section.settings.show_brand -%}
        <div class="hm-footer__brand">
          <p class="hm-header__wordmark">{{ shop.name | escape }}</p>
          {%- if section.settings.brand_text != blank -%}<div class="hm-rte hm-small">{{ section.settings.brand_text }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hm-footer__blocks">
          {%- for block in section.blocks -%}
            <div class="hm-footer__block hm-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'menu' -%}
                  {%- liquid
                    assign footer_menu = block.settings.menu
                    if footer_menu.links.size == 0
                      assign footer_menu = linklists['footer']
                    endif
                    assign heading = block.settings.heading
                    if heading == blank and footer_menu.links.size > 0
                      assign heading = footer_menu.title
                    endif
                  -%}
                  {%- if heading != blank -%}
                    <h2 class="hm-footer__heading">{{ heading | escape }}</h2>
                  {%- endif -%}
                  <ul class="hm-footer__links" role="list">
                    {%- if footer_menu.links.size > 0 -%}
                      {%- for link in footer_menu.links -%}
                        <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for handle in auto_pages -%}
                        {%- if pages[handle].title != blank -%}
                          <li><a href="{{ pages[handle].url }}">{{ pages[handle].title | escape }}</a></li>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if blogs.news.articles_count > 0 -%}
                        <li><a href="{{ blogs.news.url }}">{{ blogs.news.title | escape }}</a></li>
                      {%- endif -%}
                      <li><a href="{{ routes.search_url }}">{{ 'search.title' | t }}</a></li>
                    {%- endif -%}
                  </ul>
                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="hm-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="hm-rte">{{ block.settings.text }}</div>
                {%- when 'newsletter' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="hm-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="hm-rte hm-small">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {% render 'newsletter-form', id: 'FooterNewsletter' %}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hm-footer__row">
      {%- if section.settings.show_social -%}
        {% render 'social-icons' %}
      {%- endif -%}
      {%- if section.settings.show_follow_on_shop and shop.features.follow_on_shop? -%}
        <div class="hm-footer__follow">{{ shop | login_button: action: 'follow' }}</div>
      {%- endif -%}
      {% render 'localization', id: 'FooterLocalization', show_country: section.settings.show_country, show_language: section.settings.show_language %}
    </div>

    <div class="hm-footer__base">
      <div class="hm-footer__legal">
        <p class="hm-small">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
          {%- if settings.show_credit %}
            <span aria-hidden="true">&middot;</span>
            <a href="https://zeronkit.com" rel="noopener">{{ 'footer.credit' | t }}</a>
          {%- endif -%}
          {%- if section.settings.show_powered_by %} <span aria-hidden="true">&middot;</span> {{ powered_by_link }}{% endif %}
        </p>
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="hm-footer__policies" role="list" aria-label="{{ 'footer.policies' | t }}">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="hm-footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'hm-payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:names.footer",
  "class": "hm-shopify-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "columns", "label": "t:options.footer_columns" },
        { "value": "editorial", "label": "t:options.footer_editorial" },
        { "value": "centered", "label": "t:options.footer_centered" }
      ],
      "default": "editorial"
    },
    { "type": "checkbox", "id": "show_brand", "label": "t:labels.show_brand", "default": true },
    { "type": "richtext", "id": "brand_text", "label": "t:labels.brand_text", "default": "<p>Clothes, shoes and bags made to be worn together.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-2" },
    { "type": "checkbox", "id": "show_social", "label": "t:labels.show_social", "default": true, "info": "t:info.social" },
    { "type": "checkbox", "id": "show_follow_on_shop", "label": "t:labels.show_follow_on_shop", "default": true, "info": "t:info.follow_on_shop" },
    { "type": "checkbox", "id": "show_country", "label": "t:labels.show_country", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "t:labels.show_language", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "t:labels.show_payment", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "t:labels.show_policies", "default": true, "info": "t:info.policies" },
    { "type": "checkbox", "id": "show_powered_by", "label": "t:labels.show_powered_by", "default": false },
    { "type": "paragraph", "content": "t:info.credit" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "menu",
      "name": "t:names.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Help" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer", "info": "t:info.footer_menu" }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Tell shoppers who makes your clothes and what you stand for.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:names.newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Stay in the loop" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>New arrivals and restocks, once in a while.</p>" },
        { "type": "paragraph", "content": "t:info.newsletter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "blocks": [{ "type": "menu" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}
