{%- comment -%} Hemline theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  if collection != blank
    assign products = collection.products
  else
    # No collection chosen: show the newest products of the whole store.
    assign collection = collections.all
    assign products = collections.all.products | sort: 'published_at' | reverse
  endif
-%}
{%- assign is_rail = false -%}
{%- if section.settings.layout == 'rail' -%}{%- assign is_rail = true -%}{%- endif -%}
<section class="hm-section color-{{ section.settings.color_scheme }}">
  <hm-slider class="hm-wrap hm-slider">
    <div class="hm-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="hm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="hm-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="hm-section__actions">
        {%- if is_rail and section.settings.show_arrows -%}
          {% render 'slider-controls', label: section.settings.heading %}
        {%- endif -%}
        {%- if collection != blank and section.settings.show_view_all -%}
          <a class="hm-button hm-button--text" href="{{ collection.url }}">
            {{ 'collections.view_all' | t }}<span class="hm-visually-hidden">: {{ collection.title | escape }}</span> {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>
    <ul class="hm-grid hm-grid--{{ section.settings.columns }} hm-grid--m2{% if is_rail %} hm-grid--rail{% endif %}" role="list"{% if is_rail %} data-hm-slider-track{% endif %}>
      {%- if products.size > 0 -%}
        {%- for product in products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if is_rail -%}
      <span class="hm-slider__progress" data-hm-slider-progress hidden aria-hidden="true"><span></span></span>
    {%- endif -%}
  </hm-slider>
</section>

{% schema %}
{
  "name": "t:names.featured_collection",
  "class": "hm-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "rail", "label": "t:options.scroll_rail" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "t:labels.show_arrows_rail", "default": true, "info": "t:info.show_arrows_rail" },
    { "type": "checkbox", "id": "show_view_all", "label": "t:labels.show_view_all", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:names.featured_collection" }]
}
{% endschema %}
