{%- comment -%} Hemline theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
<section class="hm-section color-{{ section.settings.color_scheme }}">
  <hm-recommendations
    class="hm-wrap"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="hm-section__head">
        <h2 class="hm-h3">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="hm-grid hm-grid--{{ section.settings.columns }}" role="list">
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', product: rec %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </hm-recommendations>
</section>

{% schema %}
{
  "name": "t:names.related_products",
  "class": "hm-shopify-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "t:info.related" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:names.related_products" }]
}
{% endschema %}
