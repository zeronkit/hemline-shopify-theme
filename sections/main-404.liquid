{%- comment -%}
  404: a swinging garment tag drawn in SVG, a search field, the store's busiest collections
  and a row of new products. The tag only moves when motion is allowed.
{%- endcomment -%}
{%- liquid
  assign auto_list = ''
  assign auto_count = 0
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage' and auto_count < 6
      assign auto_list = auto_list | append: c.handle | append: ','
      assign auto_count = auto_count | plus: 1
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign picks = collections.all.products | sort: 'published_at' | reverse
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'not_found.title' | t
  endif
-%}
<section class="hm-section color-{{ section.settings.color_scheme }}">
  <div class="hm-wrap hm-404">
    <div class="hm-404__top">
      <div class="hm-404__art" aria-hidden="true">
        <svg viewBox="0 0 320 300" width="320" height="300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M40 18h240" opacity="0.35"/>
          <circle cx="160" cy="18" r="5" fill="currentColor" stroke="none"/>
          <g class="hm-404__tag">
            <path class="hm-404__thread" d="M160 18v46"/>
            <path d="M110 70h100l26 26v170a10 10 0 0 1-10 10H94a10 10 0 0 1-10-10V96z" fill="var(--hm-bg)"/>
            <circle cx="160" cy="88" r="7"/>
            <path d="M104 118h112" stroke-dasharray="4 6" opacity="0.55"/>
            <text x="160" y="196" text-anchor="middle" font-size="66" font-weight="700" fill="currentColor" stroke="none" style="font-family: var(--hm-font-heading); letter-spacing: -0.04em">404</text>
            <path d="M104 226h112" stroke-dasharray="4 6" opacity="0.55"/>
            <text x="160" y="254" text-anchor="middle" font-size="13" fill="currentColor" stroke="none" style="letter-spacing: 0.3em">{{ 'not_found.tag' | t }}</text>
          </g>
        </svg>
      </div>
      <div class="hm-404__copy">
        <p class="hm-eyebrow">404</p>
        <h1 class="hm-h1">{{ heading | escape }}</h1>
        <p class="hm-text--large hm-muted">{{ 'not_found.text' | t }}</p>
        {% render 'search-form', id: 'NotFoundSearch', predictive: false %}
        <a class="hm-button hm-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    </div>

    {%- if auto_handles.size > 0 -%}
      <nav class="hm-search-block" aria-labelledby="NotFoundCollections-{{ section.id }}">
        <h2 class="hm-field__label" id="NotFoundCollections-{{ section.id }}">{{ 'not_found.collections' | t }}</h2>
        <ul class="hm-chips" role="list">
          {%- for handle in auto_handles -%}
            <li><a class="hm-pill" href="{{ collections[handle].url }}">{{ collections[handle].title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if picks.size > 0 -%}
      <div class="hm-search-block">
        <h2 class="hm-h3">{{ 'search.you_may_like' | t }}</h2>
        <ul class="hm-grid hm-grid--4 hm-grid--m2" role="list">
          {%- for product in picks limit: 4 -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.not_found",
  "class": "hm-shopify-section",
  "enabled_on": { "templates": ["404"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
