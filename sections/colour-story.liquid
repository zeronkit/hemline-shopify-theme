{%- comment -%}
  Shop by colour story. Two parts, both optional:
  1. Palette blocks: a named mood (up to four colours) that links to a collection or filtered URL.
  2. Auto chips: every colour found in the chosen collection's native swatch data,
     each linking to that collection filtered by the colour option.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign auto_list = ''
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
      assign auto_list = auto_list | append: c.handle | append: ','
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign auto_index = 0
  assign locale_colour_names = 'products.option_names.colour' | t
  assign colour_names = settings.colour_option_names | append: ',' | append: locale_colour_names | downcase | replace: ', ', ',' | split: ','
  assign seen = '|'
  capture chips
    if source != blank
      for product in source.products limit: 50
        for option in product.options_with_values
          assign option_name = option.name | downcase | strip
          if option.values.first.swatch != blank or colour_names contains option_name
            for value in option.values
              assign key = value | downcase | prepend: '|' | append: '|'
              unless seen contains key
                assign seen = seen | append: key
                assign param_value = value | url_encode
                assign param_name = option_name | url_encode
                echo '<li><a class="hm-colourbar__item" href="'
                echo source.url | append: '?filter.v.option.' | append: param_name | append: '=' | append: param_value
                echo '">'
                render 'swatch', value: value, size: 'large'
                assign value_label = value | escape
                echo '<span>' | append: value_label | append: '</span></a></li>'
              endunless
            endfor
          endif
        endfor
      endfor
    endif
  endcapture
-%}
<section class="hm-section hm-colour-story color-{{ section.settings.color_scheme }}">
  <div class="hm-wrap">
    <div class="hm-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="hm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="hm-h2">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hm-palettes" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign link = block.settings.link
            if link == blank and block.settings.collection != blank
              assign link = block.settings.collection.url
            elsif link == blank and auto_handles[auto_index] != blank
              assign link = collections[auto_handles[auto_index]].url
              assign auto_index = auto_index | plus: 1
            endif
          -%}
          <li class="hm-palette" {{ block.shopify_attributes }}>
            <div class="hm-palette__bars" aria-hidden="true">
              {%- for i in (1..4) -%}
                {%- assign key = 'colour_' | append: i -%}
                {%- if block.settings[key] != blank -%}
                  <span style="background: {{ block.settings[key] }};"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.image != blank -%}
              <div class="hm-palette__image">
                {% render 'image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, 50vw', max: 1200, alt: '' %}
              </div>
            {%- endif -%}
            <h3 class="hm-palette__name hm-h4">
              {%- if link != blank -%}
                <a class="hm-card__link" href="{{ link }}">{{ block.settings.name | escape }}</a>
              {%- else -%}
                {{ block.settings.name | escape }}
              {%- endif -%}
            </h3>
            {%- if block.settings.note != blank -%}<p class="hm-small hm-muted">{{ block.settings.note | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if chips != blank -%}
      <nav class="hm-colourbar hm-colourbar--wide" aria-label="{{ 'collections.colours_in' | t: collection: source.title }}">
        <p class="hm-field__label">{{ 'collections.colours_in' | t: collection: source.title }}</p>
        <ul class="hm-colourbar__list" role="list">{{ chips }}</ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.colour_story",
  "class": "hm-shopify-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Colour stories" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop by palette" },
    { "type": "collection", "id": "collection", "label": "t:labels.colour_source", "info": "t:info.colour_source" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "palette",
      "name": "t:names.palette",
      "settings": [
        { "type": "text", "id": "name", "label": "t:labels.palette_name", "default": "Stone and sand" },
        { "type": "text", "id": "note", "label": "t:labels.palette_note", "default": "Warm neutrals that mix with everything" },
        { "type": "color", "id": "colour_1", "label": "t:labels.colour_1", "default": "#D8CBB8" },
        { "type": "color", "id": "colour_2", "label": "t:labels.colour_2", "default": "#A89780" },
        { "type": "color", "id": "colour_3", "label": "t:labels.colour_3", "default": "#6E6253" },
        { "type": "color", "id": "colour_4", "label": "t:labels.colour_4" },
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "url", "id": "link", "label": "t:labels.link_override", "info": "t:info.palette_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.colour_story",
      "blocks": [
        { "type": "palette" },
        {
          "type": "palette",
          "settings": { "name": "Ink and indigo", "note": "Deep blues for every day", "colour_1": "#1E2A44", "colour_2": "#34507A", "colour_3": "#8AA2C4" }
        },
        {
          "type": "palette",
          "settings": { "name": "Moss and clay", "note": "Earthy greens and terracotta", "colour_1": "#4F5D3A", "colour_2": "#8C9A6B", "colour_3": "#B5653F" }
        }
      ]
    }
  ]
}
{% endschema %}
